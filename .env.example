# Copiez ce fichier en .env et remplissez-le. Ne commitez JAMAIS votre .env.

# --- Kraken ---------------------------------------------------------------
# Clé API avec UNIQUEMENT : Query Funds, Query Open Orders & Trades,
# Query Closed Orders & Trades, Create & Modify Orders, Cancel/Close Orders.
# Surtout PAS « Withdraw Funds ».
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# --- Cerveau IA -----------------------------------------------------------
# auto = Claude si ANTHROPIC_API_KEY est défini, sinon règles seules.
BRAIN=auto
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high : plus haut = plus de réflexion, plus cher
CLAUDE_EFFORT=medium
MAX_LLM_CALLS_PER_DAY=6

# --- Marché ---------------------------------------------------------------
# Vide = sélection automatique des paires EUR les plus liquides.
# UNIVERSE=XBTEUR,ETHEUR,SOLEUR,XRPEUR,ADAEUR
UNIVERSE_SIZE=15
MIN_VOLUME_24H=1000000
MAX_SPREAD_PCT=0.30
# Bougies de 240 min (4 h) : moins de trades, donc moins de frais.
CANDLE_INTERVAL=240
LOOP_SECONDS=60

# --- Règles de survie -----------------------------------------------------
RISK_PER_TRADE_PCT=2.0
MAX_POSITION_PCT=90
MAX_OPEN_POSITIONS=1
# Sous 75 % du capital initial : tout est vendu et l'agent s'arrête.
SURVIVAL_FLOOR_PCT=75
DAILY_LOSS_LIMIT_PCT=6
MAX_CONSECUTIVE_LOSSES=3
COOLDOWN_HOURS=12
TAKER_FEE_PCT=0.40

# --- Simulation -----------------------------------------------------------
PAPER_START_EUR=10
DATA_DIR=data
